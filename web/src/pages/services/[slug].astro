---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import EstimateCta from '../../components/EstimateCta.astro';
import FaqList from '../../components/FaqList.astro';
import { business } from '../../data/business';
import { breadcrumbSchema, serviceSchema, faqSchema } from '../../lib/schema';
import { capsHtml } from '../../lib/caps';

export async function getStaticPaths() {
  const services = await getCollection('services');
  return services.map((service) => ({ params: { slug: service.id }, props: { service } }));
}

interface Props {
  service: CollectionEntry<'services'>;
}
const { service } = Astro.props;
const { Content } = await render(service);
const d = service.data;

const projects = (await getCollection('projects', (p) => p.data.service?.id === service.id)).sort(
  (a, b) => a.data.order - b.data.order,
);
const faqs = await getCollection('faqs', (f) => f.data.service === service.id);

const site = Astro.site!.href.replace(/\/$/, '');
const url = `${site}/services/${service.id}/`;
const schema: object[] = [
  serviceSchema({ name: d.title, description: d.metaDescription, url }),
  breadcrumbSchema([
    { name: 'Home', url: `${site}/` },
    { name: 'Services', url: `${site}/services/` },
    { name: d.shortTitle, url },
  ]),
];
// Only confirmed answers go into Google's FAQ data.
const confirmed = faqs.filter((f) => !f.data.placeholder);
if (confirmed.length) schema.push(faqSchema(confirmed.map((f) => f.data)));
---

<Base
  title={d.metaTitle}
  description={d.metaDescription}
  schema={schema}
>
  <article>
    <header class="wrap section intro">
      <Breadcrumbs
        items={[
          { name: 'Home', href: '/' },
          { name: 'Services', href: '/services/' },
          { name: d.shortTitle, href: `/services/${service.id}/` },
        ]}
      />
      <div class="intro__grid">
        <div>
          <h1 set:html={capsHtml(d.title)} />
          <p class="intro__summary">{d.summary}</p>
          <p class="label">Serving {business.serviceArea.join(', ')}, {business.region}</p>
        </div>
        {
          d.cover && (
            <Picture
              src={d.cover.src}
              width={d.cover.width}
              height={d.cover.height}
              style={`object-position: ${d.cover.position}`}
              alt={d.cover.alt}
              formats={['avif', 'webp']}
                fallbackFormat="jpg"
              widths={[480, 720, 960]}
              sizes="(min-width: 60rem) 45vw, 100vw"
              loading="eager"
              fetchpriority="high"
              class="intro__img"
            />
          )
        }
      </div>
    </header>

    <div class="wrap prose body">
      <Content />
    </div>

    {
      projects.length > 0 && (
        <section class="wrap section" aria-labelledby="projects-heading">
          <h2 id="projects-heading">{d.shortTitle} we've built</h2>
          <div class="grid">
            {projects.map((p) => <ProjectCard project={p} />)}
          </div>
        </section>
      )
    }

    {
      faqs.length > 0 && (
        <section class="wrap section" aria-labelledby="faq-heading">
          <h2 id="faq-heading">Frequently asked questions</h2>
          <FaqList faqs={faqs} />
          <p class="faq-more"><a href="/faq/">All questions &amp; answers</a></p>
        </section>
      )
    }
  </article>
  <EstimateCta heading="Ready to get started?" />
</Base>

<style>
  .intro {
    padding-bottom: var(--space-l);
  }
  .intro__grid {
    display: grid;
    gap: var(--space-l);
    align-items: center;
  }
  .intro h1 {
    font-size: var(--step-3);
  }
  .intro__summary {
    font-size: var(--step-1);
    color: var(--ink-soft);
  }
  .intro__img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius);
  }
  .body {
    padding-bottom: var(--space-l);
  }
  .grid {
    display: grid;
    gap: var(--space-m);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
    margin-top: var(--space-l);
  }
  .faq-more {
    margin-top: var(--space-s);
  }
  @media (min-width: 60rem) {
    .intro__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
