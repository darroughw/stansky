---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import EstimateCta from '../../components/EstimateCta.astro';
import { breadcrumbSchema } from '../../lib/schema';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const site = Astro.site!.href.replace(/\/$/, '');
---

<Base
  title="Remodeling Portfolio | Stansky Construction, Winston-Salem"
  description="Kitchens, bathrooms, porches and decks built by Stansky Construction in Winston-Salem and Clemmons, NC. Real projects, real photos."
  schema={[
    breadcrumbSchema([
      { name: 'Home', url: `${site}/` },
      { name: 'Our work', url: `${site}/portfolio/` },
    ]),
  ]}
>
  <div class="wrap section">
    <Breadcrumbs items={[{ name: 'Home', href: '/' }, { name: 'Our work', href: '/portfolio/' }]} />
    <h1>Our work</h1>
    <p class="intro">Every photo here is a Stansky Construction project.</p>
    <div class="grid">
      {projects.map((p) => <ProjectCard project={p} headingLevel="h2" />)}
    </div>
  </div>
  <EstimateCta />
</Base>

<style>
  .intro {
    font-size: var(--step-1);
    color: var(--ink-soft);
  }
  .grid {
    display: grid;
    gap: var(--space-m);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
    margin-top: var(--space-l);
  }
</style>
