---
import { getCollection } from 'astro:content';
import { business, telHref } from '../data/business';

interface Props {
  heading?: string;
  /** Show a client review beside the buttons. Off where the page already shows reviews. */
  review?: boolean;
}
const { heading = 'Start your project today', review: showReview = true } = Astro.props;

// A short review right where people decide whether to get in touch. Each page gets one
// of the short ones, picked from its path so it stays the same between builds.
const short = (await getCollection('reviews')).filter((r) => r.data.text.length <= 280);
const seed = [...Astro.url.pathname].reduce((n, c) => n + c.charCodeAt(0), 0);
const review = showReview && short.length > 0 ? short[seed % short.length] : undefined;
---

<section class="cta" aria-labelledby="cta-heading">
  <div class="wrap cta__inner">
    <div>
      <h2 id="cta-heading" class="cta__heading">{heading}</h2>
      <p>
        Contact us to schedule a walkthrough. Jack will visit your home, talk through your plans and
        provide a written estimate.
      </p>
      {
        review && (
          <figure class="cta__review">
            <blockquote>
              <p>“{review.data.text}”</p>
            </blockquote>
            <figcaption>
              {review.data.rating === 5 && (
                <>
                  <span aria-hidden="true">★★★★★ </span>
                  <span class="visually-hidden">5 stars, </span>
                </>
              )}
              {review.data.author}
            </figcaption>
          </figure>
        )
      }
    </div>
    <div class="cta__actions">
      <a class="button cta__primary" href="/contact/">Request an estimate</a>
      {
        business.phone && (
          <a class="button button--ghost cta__ghost" href={telHref(business.phone)}>
            Call {business.phone}
          </a>
        )
      }
    </div>
  </div>
</section>

<style>
  .cta {
    background: var(--cab);
    color: #fff;
    padding-block: var(--space-l);
  }
  .cta__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-m);
  }
  .cta__heading {
    font-size: var(--step-2);
    margin-bottom: var(--space-xs);
  }
  .cta p {
    margin: 0;
  }
  .cta__review {
    margin: var(--space-s) 0 0;
    padding-left: var(--space-s);
    border-left: 3px solid rgba(255, 255, 255, 0.6);
    max-width: 38rem;
  }
  .cta__review blockquote {
    margin: 0;
    font-style: italic;
  }
  .cta__review figcaption {
    margin-top: 0.35rem;
    font-size: var(--step--1);
    font-weight: 700;
  }
  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
  }
  .cta__primary {
    background: var(--paper);
    border-color: var(--paper);
    color: var(--ink);
  }
  .cta__primary:hover {
    background: #fff;
    border-color: #fff;
    color: var(--ink);
  }
  .cta__ghost {
    color: #fff;
    border-color: #fff;
  }
  .cta__ghost:hover {
    background: #fff;
    color: var(--cab);
  }
  .cta :focus-visible {
    outline-color: #fff;
  }
</style>
