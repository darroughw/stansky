---
import '../styles/global.css';
import fontUrl from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Photo } from '../lib/sanity';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { business } from '../data/business';
import { businessSchema } from '../lib/schema';
import { warnMissingBusinessInfo } from '../lib/checks';
import defaultShare from '../assets/projects/screened-porch-after.jpg';
import truck from '../assets/brand/truck.svg';

interface Props {
  /** Full <title>. Keep under ~60 characters and lead with what the page is about. */
  title: string;
  /** Meta and social description, under ~160 characters. */
  description: string;
  /** Share image; defaults to a project photo. */
  image?: ImageMetadata | Photo;
  imageAlt?: string;
  type?: 'website' | 'article';
  /** Extra JSON-LD objects for this page. */
  schema?: object[];
  noindex?: boolean;
}

const {
  title,
  description,
  image = defaultShare,
  imageAlt = 'Screened porch rebuilt by Stansky Construction',
  type = 'website',
  schema = [],
  noindex = false,
} = Astro.props;

warnMissingBusinessInfo();

// Launch switch: until SITE_LIVE=true is set (in Netlify, once the real domain points here),
// every page is noindex so the *.netlify.app copy can't compete with the live GoDaddy site.
const isLive = import.meta.env.SITE_LIVE === 'true';

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const share = await getImage({ src: 'position' in image ? image.src : image, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
const shareUrl = new URL(share.src, Astro.site).href;
const logoUrl = new URL(truck.src, Astro.site).href;

const jsonLd = [businessSchema({ logo: logoUrl, image: shareUrl }), ...schema];
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {(noindex || !isLive) && <meta name="robots" content="noindex" />}

    <link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#f5f6f1" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={business.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />

    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: var(--gutter);
    top: -100px;
    z-index: 100;
    padding: 0.75em 1.25em;
    background: var(--ink);
    color: var(--paper);
    font-weight: 700;
    border-radius: var(--radius);
  }
  .skip-link:focus {
    top: var(--space-s);
  }
  main:focus {
    outline: none;
  }
</style>
